# Example ENV file for development (not for production use!)

# Hub
APP_URL=http://localhost:3000
PORT=8080
HOST=127.0.0.1
APP_SECRET=
DISABLE_UI=true
# Lets the hub reach the Gitea mock (just run-gitea-mock) and trust its self-signed certificate
ALLOWED_INTERNAL_IPS=127.0.0.1,::1
CA_CERT_FILE=../e2e/mock/certs/mock.pem
ALLOWED_IPS=
DEMO=false
# Local agents are built from untagged commits and would be flagged as too old
SKIP_AGENT_VERSION_CHECK=true

# Agent
HUB_URL=http://localhost:8080/
AUTH_TOKEN=
DEPLOYMENTS_DIR=./data/agent/deployments
