set dotenv-load := true
set windows-shell := ["pwsh", "-NoLogo", "-NoProfile", "-Command"]

VERSION := if os_family() == 'windows' {
    `git describe --tags --always --dirty 2>$null; if (-not $?) { "dev" }`
} else {
    `git describe --tags --always --dirty 2>/dev/null || echo "dev"`
}
COMMIT := if os_family() == 'windows' {
    `git rev-parse --short HEAD 2>$null; if (-not $?) { "none" }`
} else {
    `git rev-parse --short HEAD 2>/dev/null || echo "none"`
}
DATE := if os_family() == 'windows' {
    `(Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')`
} else {
    `date -u +%Y-%m-%dT%H:%M:%SZ`
}
# Dev builds leave out the build date so the ldflags stay stable and go run can reuse its cached binary
DEV_LDFLAGS := "-s -w -X github.com/OrcaCD/orca-cd/internal/version.Version=" + VERSION + " -X github.com/OrcaCD/orca-cd/internal/version.Commit=" + COMMIT
LDFLAGS := DEV_LDFLAGS + " -X github.com/OrcaCD/orca-cd/internal/version.BuildDate=" + DATE
EXT := if os_family() == 'windows' { '.exe' } else { '' }
AIR := if os_family() == 'windows' {
    `if (Get-Command air -ErrorAction SilentlyContinue) { 'air' }`
} else {
    `command -v air || true`
}
HUB_FLAGS := "-tags=nomsgpack -ldflags '" + DEV_LDFLAGS + "'"
AGENT_FLAGS := "-ldflags '" + DEV_LDFLAGS + "'"
HUB_RUN := "go run " + HUB_FLAGS + " ./cmd/hub"
AGENT_RUN := "go run " + AGENT_FLAGS + " ./cmd/agent"
HUB_AIR := "air -c .air.hub.toml --build.cmd \"go build " + HUB_FLAGS + " -o bin/hub" + EXT + " ./cmd/hub\""
AGENT_AIR := "air -c .air.agent.toml --build.cmd \"go build " + AGENT_FLAGS + " -o bin/agent" + EXT + " ./cmd/agent\""
defaultCommand := ""

# List all available commands
default:
    @just --list

# Run linter and verify module dependencies
lint:
    golangci-lint run
    go mod verify
    buf lint

# Format source code using golangci-lint
alias fmt := format
format:
    golangci-lint fmt
    buf format -w

# Compile protobuf to go
proto:
    buf generate

# Run all tests with race detection
[group('test')]
[env("CGO_ENABLED", "1")]
test:
   gotestsum -- -tags=nomsgpack -race -failfast ./...

# Run all tests with race detection and coverage report
[group('test')]
[env("CGO_ENABLED", "1")]
test-coverage:
    gotestsum -- -tags=nomsgpack -race -coverprofile coverage.txt -covermode atomic ./...
    go tool cover -html coverage.txt

# Build the hub binary to bin/hub
[group('hub')]
[env("CGO_ENABLED", "1")]
build-hub: proto
    go build -tags=nomsgpack -ldflags '{{ LDFLAGS }}' -o bin/hub{{ EXT }} ./cmd/hub

# Build the agent binary to bin/agent
[group('agent')]
[env("CGO_ENABLED", "1")]
build-agent: proto
    go build -ldflags '{{ LDFLAGS }}' -o bin/agent{{ EXT }} ./cmd/agent

# Build both hub and agent binaries in parallel
[parallel]
build: build-hub build-agent

# Run the hub, live reloading with air if installed (use the help command to get a list of commands)
[group('hub')]
[env("CGO_ENABLED", "1")]
run-hub cmd=defaultCommand: proto
    {{ if cmd != "" { HUB_RUN + " " + cmd } else if AIR == "" { HUB_RUN } else { HUB_AIR } }}

# Run the agent, live reloading with air if installed (use the help command to get a list of commands)
[group('agent')]
[env("CGO_ENABLED", "1")]
run-agent cmd=defaultCommand: proto
    {{ if cmd != "" { AGENT_RUN + " " + cmd } else if AIR == "" { AGENT_RUN } else { AGENT_AIR } }}

# Run both hub and agent in parallel
[parallel]
run: run-hub run-agent

# Print the current version, commit, and build date
version:
    @echo "Version: {{ VERSION }}"
    @echo "Commit:  {{ COMMIT }}"
    @echo "Date:    {{ DATE }}"
