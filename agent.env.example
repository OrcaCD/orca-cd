# Do not put the hub's APP_SECRET in this file: compose files deployed by the agent can read the agent's environment.

HUB_URL=https://... # Public URL of the Hub, should be the same as APP_URL

AUTH_TOKEN= # Create a token in the Hub UI and use it here

# CA_CERT_FILE= # Path to a PEM encoded CA certificate, required if the Hub uses a self-signed or otherwise untrusted certificate
